{
  "name": "@tummycrypt/tinyland-invitation",
  "version": "0.2.7",
  "description": "Admin invitation management with TOTP setup and audit logging",
  "type": "module",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:testing": "tsc -p tsconfig.testing.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist dist-testing",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.testing.json",
    "check:package": "publint",
    "smoke:consumer": "node scripts/smoke-consumer.mjs"
  },
  "author": "Tinyland.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyland-inc/tinyland-invitation.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "publint": "^0.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/tinyland-inc/tinyland-invitation",
  "bugs": {
    "url": "https://github.com/tinyland-inc/tinyland-invitation/issues"
  }
}
